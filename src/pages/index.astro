---
import {
	Container,
	Hero,
	Breadcrumb,
	Heading,
	Columns,
} from "react-bulma-components";
import { Icon } from "astro-icon/components";
import AlbumCard from "../components/AlbumCard.astro";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
let all_albums = (await getCollection("albums")).sort(
	(a, b) => b.data.sort_timestamp - a.data.sort_timestamp,
);
---

<Layout>
	<Container style={{ flex: 1 }}>
		<Hero size="small">
			<Hero.Body>
				<Breadcrumb>
					<Breadcrumb.Item active>
						<Icon name="fa6-solid:book" size="1.33em" />
						<Heading
							size={5}
							className="has-text-text"
							style={{ marginLeft: "1em" }}
							renderAs="a">Albums</Heading
						>
					</Breadcrumb.Item>
				</Breadcrumb>
			</Hero.Body>
		</Hero>
		<Columns multiline>
			{all_albums.map((album) => <AlbumCard subject={album.data} />)}
		</Columns>
	</Container>
</Layout>
