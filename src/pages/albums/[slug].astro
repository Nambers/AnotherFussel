---
import "../../styles/album.css";
import { getCollection } from "astro:content";
import { Container, Hero, Breadcrumb, Heading } from "react-bulma-components";
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
// import Masonry, { ResponsiveMasonry } from "react-responsive-masonry"
// import Modal from "react-modal";
import { Masonry } from "astro-masonry";
import { Picture } from "astro:assets";

export async function getStaticPaths() {
    const albums = await getCollection("albums");
    return albums.map((album) => ({
        params: { slug: album.data.slug },
    }));
}

const { slug } = Astro.params;
const albums = await getCollection(
    "albums",
    (entry) => entry.data.slug === slug,
);
if (albums.length === 0) {
    throw new Error(`Album with slug "${slug}" not found.`);
}
const album = albums[0].data;
const photos = (
    await getCollection("photos", (entry) => entry.data.album_slug === slug)
).map((entry) => entry.data);
---

<Layout>
    <Container style={{ flex: 1 }}>
        <Hero size="small">
            <Hero.Body>
                <Breadcrumb>
                    <Breadcrumb.Item>
                        <Icon name="fa6-solid:book" size="1.33em" />
                        <a
                            class="title is-5"
                            href="/"
                            style={{ marginLeft: "1em" }}>Albums</a
                        >
                    </Breadcrumb.Item>
                    <Breadcrumb.Item active>
                        <Heading size={5} className="has-text-text" renderAs="a"
                            >{album.name}</Heading
                        >
                    </Breadcrumb.Item>
                </Breadcrumb>
            </Hero.Body>
        </Hero>

        <Masonry
            class="container astro-masonry-grid columns is-1"
            breakpointCols={{
                300: 1,
                600: 2,
                900: 3,
                1200: 4,
                default: 4,
            }}
            columnClass="astro-masonry-grid_column column"
        >
            {
                photos.map((image, i) => (
                    <a
                        data-index={i}
                        href={"/albums/" + album.slug + "/" + image.slug + "/"}
                        class="masonry-images"
                    >
                        <Picture
                            quality="mid"
                            src={image.path}
                            alt={image.name}
                            formats={["webp"]}
                            widths={[360, 720, 1080]}
                            sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 25vw"
                            class="gallery-image w-full"
                            loading="lazy"
                            decoding="async"
                        />
                    </a>
                ))
            }
        </Masonry>
    </Container>
</Layout>
